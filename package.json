{
  "name": "durandal",
  "displayName": "Durandal",
  "description": "Olifant in VS Code: conventions, generators, the TDD loop and plans over olifant lsp",
  "publisher": "sorcererdev",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorcererdev/durandal-vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.olifant/config.toml",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "durandal.path chooses the binary the extension runs."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Durandal",
      "properties": {
        "durandal.path": {
          "type": "string",
          "default": "olifant",
          "markdownDescription": "The `olifant` binary: an absolute path, or a name looked up on `PATH`, `~/.local/bin`, `~/.cabal/bin` and `~/bin`."
        },
        "durandal.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "How long typing must pause before the server's slow work (suggestions) starts (`debounce_ms`)."
        },
        "durandal.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which `[model.backends.NAME]` fills holes; empty: the project's `[model]` default."
        },
        "durandal.fills": {
          "type": "string",
          "default": "",
          "markdownDescription": "A recorded `[fills]` file standing in for the model (tests, demos); empty: none."
        },
        "durandal.actionLog": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Append the actions offered and picked to `actions.jsonl` in `$DURANDAL_LOG_DIR`, else `$XDG_CACHE_HOME/durandal`, else `~/.cache/durandal` (the file durandal.nvim writes), to tune where generators apply."
        },
        "durandal.hints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show ⚡ at the end of each line where an Olifant action applies; clicking it opens the actions there. `Durandal: Toggle ⚡ Hints` flips it."
        },
        "durandal.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the LSP traffic with olifant lsp into the Durandal output channel."
        }
      }
    },
    "commands": [
      {
        "command": "durandal.showHealth",
        "title": "Show Health",
        "category": "Durandal"
      },
      {
        "command": "durandal.restartServer",
        "title": "Restart Server",
        "category": "Durandal"
      },
      {
        "command": "durandal.actions",
        "title": "Actions Here",
        "category": "Durandal"
      },
      {
        "command": "durandal.hints.toggle",
        "title": "Toggle ⚡ Hints",
        "category": "Durandal"
      },
      {
        "command": "durandal.migration",
        "title": "Migration Report",
        "category": "Durandal"
      },
      {
        "command": "durandal.generate",
        "title": "Generate…",
        "category": "Durandal"
      },
      {
        "command": "durandal.generate.apply",
        "title": "Generate: Apply",
        "category": "Durandal",
        "enablement": "durandal.formOpen"
      },
      {
        "command": "durandal.generate.review",
        "title": "Generate: Review Plan",
        "category": "Durandal",
        "enablement": "durandal.formOpen"
      },
      {
        "command": "durandal.test.file",
        "title": "Run This File's Tests",
        "category": "Durandal"
      },
      {
        "command": "durandal.test.all",
        "title": "Run All Tests",
        "category": "Durandal"
      },
      {
        "command": "durandal.jump",
        "title": "Jump to Test or Module",
        "category": "Durandal"
      },
      {
        "command": "durandal.stub",
        "title": "Stub a Test",
        "category": "Durandal"
      },
      {
        "command": "durandal.conjure",
        "title": "Conjure",
        "category": "Durandal"
      },
      {
        "command": "durandal.mutate",
        "title": "Mutate",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.ask",
        "title": "Plan: Ask",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.validate",
        "title": "Plan: Validate",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.do",
        "title": "Plan: Do",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.accept",
        "title": "Plan: Accept",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.reject",
        "title": "Plan: Reject",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.files",
        "title": "Plan: Files",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.reconcile",
        "title": "Plan: Reconcile",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.excerpt",
        "title": "Plan: Excerpt",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.review",
        "title": "Plan: Review",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.toggle",
        "title": "Plan: Toggle Reading",
        "category": "Durandal"
      }
    ],
    "keybindings": [
      {
        "command": "durandal.actions",
        "key": "ctrl+alt+d a",
        "mac": "cmd+alt+d a",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.generate",
        "key": "ctrl+alt+d g",
        "mac": "cmd+alt+d g",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.test.file",
        "key": "ctrl+alt+d t",
        "mac": "cmd+alt+d t",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.test.all",
        "key": "ctrl+alt+d shift+t",
        "mac": "cmd+alt+d shift+t",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.jump",
        "key": "ctrl+alt+d j",
        "mac": "cmd+alt+d j",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.stub",
        "key": "ctrl+alt+d s",
        "mac": "cmd+alt+d s",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.conjure",
        "key": "ctrl+alt+d c",
        "mac": "cmd+alt+d c",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.mutate",
        "key": "ctrl+alt+d m",
        "mac": "cmd+alt+d m",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.plan.ask",
        "key": "ctrl+alt+d p q",
        "mac": "cmd+alt+d p q",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.validate",
        "key": "ctrl+alt+d p v",
        "mac": "cmd+alt+d p v",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.do",
        "key": "ctrl+alt+d p d",
        "mac": "cmd+alt+d p d",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.accept",
        "key": "ctrl+alt+d p y",
        "mac": "cmd+alt+d p y",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.reject",
        "key": "ctrl+alt+d p n",
        "mac": "cmd+alt+d p n",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.files",
        "key": "ctrl+alt+d p f",
        "mac": "cmd+alt+d p f",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.reconcile",
        "key": "ctrl+alt+d p c",
        "mac": "cmd+alt+d p c",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.excerpt",
        "key": "ctrl+alt+d p e",
        "mac": "cmd+alt+d p e",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.review",
        "key": "ctrl+alt+d p r",
        "mac": "cmd+alt+d p r",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.toggle",
        "key": "ctrl+alt+d p x",
        "mac": "cmd+alt+d p x",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.generate.apply",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "durandal.formOpen && inQuickOpen"
      },
      {
        "command": "durandal.generate.review",
        "key": "ctrl+o",
        "mac": "ctrl+o",
        "when": "durandal.formOpen && inQuickOpen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver-protocol": "3.18.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
