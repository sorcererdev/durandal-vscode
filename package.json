{
  "name": "durandal",
  "displayName": "Durandal",
  "description": "Olifant in VS Code: conventions, generators, the TDD loop and plans over olifant lsp",
  "publisher": "sorcererdev",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sorcererdev/durandal-vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.olifant/config.toml",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "durandal.path chooses the binary the extension runs."
    }
  },
  "contributes": {
    "configuration": {
      "title": "Durandal",
      "properties": {
        "durandal.path": {
          "type": "string",
          "default": "olifant",
          "markdownDescription": "The `olifant` binary: an absolute path, or a name looked up on `PATH`, `~/.local/bin`, `~/.cabal/bin` and `~/bin`."
        },
        "durandal.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "How long typing must pause before suggestions are worked out: the server's slow work (`debounce_ms`, after a restart) and the editor's suggestion pause (at once)."
        },
        "durandal.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which `[model.backends.NAME]` fills holes; empty: the project's `[model]` default."
        },
        "durandal.fills": {
          "type": "string",
          "default": "",
          "markdownDescription": "A recorded `[fills]` file standing in for the model (tests, demos); empty: none."
        },
        "durandal.actionLog": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Append the actions offered and picked to `actions.jsonl` in `$DURANDAL_LOG_DIR`, else `$XDG_CACHE_HOME/durandal`, else `~/.cache/durandal` (the file durandal.nvim writes), to tune where generators apply."
        },
        "durandal.hints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show ⚡ at the end of each line where an Olifant action applies; clicking it opens the actions there. `Durandal: Toggle ⚡ Hints` flips it."
        },
        "durandal.ghosts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what Olifant suggests at the cursor: the anticipated snippet as ghost text (Tab inserts it and the model fills its holes), follow-ups and recognitions as ⚡ at the end of the line (Tab reviews). Esc dismisses a suggestion on that line. `Durandal: Toggle Ghost Text` flips it. Snippets in the completion list are unaffected."
        },
        "durandal.plans.dir": {
          "type": "string",
          "default": "plans",
          "markdownDescription": "The folder, under each Olifant project, whose markdown files are plans. It must match `[plans] dir` in `.olifant/config.toml`: the server decides which files are plans, this setting only where Durandal's plan chords and decorations apply."
        },
        "durandal.plans.conceal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show plan markers as glyphs (`☐ ☑ ? · +`) and hide anchor paths and fingerprints, on every line but the cursor's. Off: the raw text, coloured by the theme."
        },
        "durandal.plans.glyphs": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "todo": { "type": "string", "description": "An open step's marker `- [ ]` (default ☐)." },
            "done": { "type": "string", "description": "A ticked step's marker `- [x]` (default ☑)." },
            "question": { "type": "string", "description": "A question's marker `- ?` (default ?)." },
            "test": { "type": "string", "description": "A test child's marker `- test:` (default ·)." },
            "also": { "type": "string", "description": "An also child's marker `- also` (default +)." },
            "dash": { "type": "string", "description": "Any other line's `- ` (default: hidden)." },
            "path": { "type": "string", "description": "An anchor's `@path:` (default: hidden)." },
            "hex": { "type": "string", "description": "A fingerprint (default: hidden)." },
            "queued": { "type": "string", "description": "Margin: a claim waiting for a check (default ○)." },
            "checking": { "type": "string", "description": "Margin: a claim being checked (default …)." },
            "right": { "type": "string", "description": "Margin: a claim checked right (default ✓)." },
            "wrong": { "type": "string", "description": "Margin: a claim checked wrong (default ✗)." },
            "unsure": { "type": "string", "description": "Margin: a claim the check could not tell (default ?)." }
          },
          "markdownDescription": "Overrides of the plan glyphs, by name. An empty string hides the text and shows nothing."
        },
        "durandal.plans.foldDone": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Close done steps and answered questions, as well as code excerpts, when a plan is first shown. Off: close only the excerpts."
        },
        "durandal.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the LSP traffic with olifant lsp into the Durandal output channel."
        }
      }
    },
    "commands": [
      {
        "command": "durandal.showHealth",
        "title": "Show Health",
        "category": "Durandal"
      },
      {
        "command": "durandal.restartServer",
        "title": "Restart Server",
        "category": "Durandal"
      },
      {
        "command": "durandal.actions",
        "title": "Actions Here",
        "category": "Durandal"
      },
      {
        "command": "durandal.hints.toggle",
        "title": "Toggle ⚡ Hints",
        "category": "Durandal"
      },
      {
        "command": "durandal.migration",
        "title": "Migration Report",
        "category": "Durandal"
      },
      {
        "command": "durandal.ghosts.toggle",
        "title": "Toggle Ghost Text",
        "category": "Durandal"
      },
      {
        "command": "durandal.suggest.dismiss",
        "title": "Dismiss Suggestion",
        "category": "Durandal",
        "enablement": "durandal.ghostVisible"
      },
      {
        "command": "durandal.suggest.accept",
        "title": "Accept Suggestion",
        "category": "Durandal",
        "enablement": "durandal.ghostVisible"
      },
      {
        "command": "durandal.generate",
        "title": "Generate…",
        "category": "Durandal"
      },
      {
        "command": "durandal.generate.apply",
        "title": "Generate: Apply",
        "category": "Durandal",
        "enablement": "durandal.formOpen"
      },
      {
        "command": "durandal.generate.review",
        "title": "Generate: Review Plan",
        "category": "Durandal",
        "enablement": "durandal.formOpen"
      },
      {
        "command": "durandal.test.here",
        "title": "Run the Test Here",
        "category": "Durandal"
      },
      {
        "command": "durandal.test.file",
        "title": "Run This File's Tests",
        "category": "Durandal"
      },
      {
        "command": "durandal.test.all",
        "title": "Run All Tests",
        "category": "Durandal"
      },
      {
        "command": "durandal.jump",
        "title": "Jump to Test or Module",
        "category": "Durandal"
      },
      {
        "command": "durandal.stub",
        "title": "Stub a Test",
        "category": "Durandal"
      },
      {
        "command": "durandal.conjure",
        "title": "Conjure",
        "category": "Durandal"
      },
      {
        "command": "durandal.mutate",
        "title": "Mutate",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.ask",
        "title": "Plan: Ask",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.validate",
        "title": "Plan: Validate",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.do",
        "title": "Plan: Do",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.accept",
        "title": "Plan: Accept",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.reject",
        "title": "Plan: Reject",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.files",
        "title": "Plan: Files",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.reconcile",
        "title": "Plan: Reconcile",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.excerpt",
        "title": "Plan: Excerpt",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.review",
        "title": "Plan: Review",
        "category": "Durandal"
      },
      {
        "command": "durandal.plan.toggle",
        "title": "Plan: Toggle Reading",
        "category": "Durandal"
      }
    ],
    "keybindings": [
      {
        "command": "durandal.actions",
        "key": "ctrl+alt+d a",
        "mac": "cmd+alt+d a",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.generate",
        "key": "ctrl+alt+d g",
        "mac": "cmd+alt+d g",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.test.here",
        "key": "ctrl+alt+d t",
        "mac": "cmd+alt+d t",
        "when": "durandal.inProject || resourceScheme == durandal-doc || resourceScheme == untitled"
      },
      {
        "command": "durandal.test.file",
        "key": "ctrl+alt+d shift+t",
        "mac": "cmd+alt+d shift+t",
        "when": "durandal.inProject || resourceScheme == durandal-doc || resourceScheme == untitled"
      },
      {
        "command": "durandal.jump",
        "key": "ctrl+alt+d j",
        "mac": "cmd+alt+d j",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.stub",
        "key": "ctrl+alt+d s",
        "mac": "cmd+alt+d s",
        "when": "durandal.inProject || resourceScheme == durandal-doc || resourceScheme == untitled"
      },
      {
        "command": "durandal.conjure",
        "key": "ctrl+alt+d c",
        "mac": "cmd+alt+d c",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.mutate",
        "key": "ctrl+alt+d m",
        "mac": "cmd+alt+d m",
        "when": "durandal.inProject"
      },
      {
        "command": "durandal.plan.ask",
        "key": "ctrl+alt+d p q",
        "mac": "cmd+alt+d p q",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.validate",
        "key": "ctrl+alt+d p v",
        "mac": "cmd+alt+d p v",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.do",
        "key": "ctrl+alt+d p d",
        "mac": "cmd+alt+d p d",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.accept",
        "key": "ctrl+alt+d p y",
        "mac": "cmd+alt+d p y",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.reject",
        "key": "ctrl+alt+d p n",
        "mac": "cmd+alt+d p n",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.files",
        "key": "ctrl+alt+d p f",
        "mac": "cmd+alt+d p f",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.reconcile",
        "key": "ctrl+alt+d p c",
        "mac": "cmd+alt+d p c",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.excerpt",
        "key": "ctrl+alt+d p e",
        "mac": "cmd+alt+d p e",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.review",
        "key": "ctrl+alt+d p r",
        "mac": "cmd+alt+d p r",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.plan.toggle",
        "key": "ctrl+alt+d p x",
        "mac": "cmd+alt+d p x",
        "when": "durandal.isPlan"
      },
      {
        "command": "durandal.generate.apply",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "durandal.formOpen && inQuickOpen"
      },
      {
        "command": "durandal.generate.review",
        "key": "ctrl+o",
        "mac": "ctrl+o",
        "when": "durandal.formOpen && inQuickOpen"
      },
      {
        "command": "durandal.suggest.accept",
        "key": "tab",
        "when": "durandal.ghostVisible && durandal.ghostKind != 'snippet' && durandal.ghostBand != 'hint' && editorTextFocus && !inlineSuggestionVisible && !suggestWidgetVisible && !inSnippetMode && !editorReadonly"
      },
      {
        "command": "durandal.suggest.dismiss",
        "key": "escape",
        "when": "inlineSuggestionVisible && durandal.ghostVisible && durandal.ghostKind == 'snippet'"
      },
      {
        "command": "durandal.suggest.dismiss",
        "key": "escape",
        "when": "durandal.ghostVisible && durandal.ghostKind != 'snippet' && durandal.ghostBand != 'hint' && editorTextFocus && !inlineSuggestionVisible && !suggestWidgetVisible && !editorHasSelection && !editorHasMultipleSelections && !findWidgetVisible && !parameterHintsVisible && !inSnippetMode && !renameInputVisible"
      }
    ],
    "semanticTokenTypes": [
      { "id": "planMarker", "superType": "string", "description": "A plan line's marker: `- [ ]`, `- [x]`, `- ?`, `- test:`, `- also`, `- `." },
      { "id": "planStep", "superType": "string", "description": "An open step's text." },
      { "id": "planStepDone", "superType": "string", "description": "A ticked step's text." },
      { "id": "planQuestion", "superType": "class", "description": "A question's text." },
      { "id": "planEvidence", "superType": "comment", "description": "Evidence under a claim or question." },
      { "id": "planClaim", "superType": "string", "description": "A claim's text." },
      { "id": "planTest", "superType": "string", "description": "A step's test sentence." },
      { "id": "planAlso", "superType": "comment", "description": "An also child of a step." },
      { "id": "planJournal", "superType": "comment", "description": "A journal line of a past do." },
      { "id": "planAnchorPath", "superType": "number", "description": "An anchor's `@path:`." },
      { "id": "planAnchorUnit", "superType": "variable", "description": "An anchor's unit." },
      { "id": "planVerdict", "superType": "number", "description": "A verdict mark: ✓, ✗, ○, ●, `? not found`." },
      { "id": "planFingerprint", "superType": "number", "description": "A verified anchor's fingerprint." }
    ],
    "semanticTokenModifiers": [
      { "id": "done", "description": "Under a ticked step." },
      { "id": "stale", "description": "A fingerprint the unit no longer has." },
      { "id": "notFound", "description": "An anchor's unit the server cannot find." },
      { "id": "checked", "description": "A claim a check found right." },
      { "id": "wrong", "description": "A claim a check found wrong." },
      { "id": "resolved", "description": "No longer given by the server; kept for its legend." }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "planMarker": ["punctuation.definition.list.begin.markdown"],
          "planStep": ["string"],
          "planStepDone": ["string"],
          "planQuestion": ["markup.heading"],
          "planEvidence": ["comment"],
          "planClaim": ["string"],
          "planTest": ["string"],
          "planAlso": ["comment"],
          "planJournal": ["comment"],
          "planAnchorPath": ["constant.numeric"],
          "planAnchorUnit": ["variable"],
          "planVerdict": ["constant.numeric"],
          "planFingerprint": ["constant.numeric"],
          "*.stale": ["comment"]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap && esbuild webview/main.ts --bundle --outfile=dist/webview.js --format=iife --platform=browser --target=es2022 && node -e \"require('fs').copyFileSync('webview/pause.css','dist/pause.css')\"",
    "compile": "tsc -p .",
    "lint": "tsc -p . --noEmit && tsc -p webview --noEmit && eslint .",
    "test:unit": "tsc -p . && node --test \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && tsc -p . && node out/test/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver-protocol": "3.18.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
